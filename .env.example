# Slack Webhook URL (필수: 슬랙 채널에 메시지를 전송하기 위한 웹훅 주소)
# 발급 방법: Slack API -> Incoming Webhooks -> Add New Webhook to Workspace
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# LLM API 키 (Gemini 또는 OpenAI 중 택 1 이상 설정)
# Google Gemini API 키 (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API 키 (선택 사항: config.yaml에서 provider를 openai로 변경 시 사용)
OPENAI_API_KEY=your_openai_api_key_here

# Notion 연동 설정 (선택 사항: 노션 데이터베이스에 동시 정리할 경우)
# 발급 방법: https://www.notion.so/profile/integrations -> 새 API 통합 생성
NOTION_API_KEY=ntn_your_notion_api_secret_key_here
# 노션 데이터베이스 ID (데이터베이스 URL에서 32자리 문자열)
NOTION_DATABASE_ID=your_notion_database_id_here
